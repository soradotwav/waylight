{
	"schemaVersion": 1,
	"id": "waylight",
	"version": "${version}",
	"name": "Waylight",
	"description": "Client-side virtual lantern for Minecraft: carry a configurable vanilla lantern on your hip or in hand with dynamic light, no inventory item required.",
	"authors": [
		"soradotwav"
	],
	"contact": {
		"issues": "https://github.com/soradotwav/waylight/issues",
		"sources": "https://github.com/soradotwav/waylight"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/waylight/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.soradotwav.Waylight"
		],
		"client": [
			"com.soradotwav.WaylightClient"
		],
		"modmenu": [
			"com.soradotwav.waylight.integration.WaylightModMenuCompat"
		]
	},
	"mixins": [
		"waylight.mixins.json",
		{
			"config": "waylight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${target_fabricloader}",
		"minecraft": "${target_minecraft}",
		"java": ">=${target_java}",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=${target_yacl}",
		"lambdynlights": ">=${target_lambdynamiclights}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
